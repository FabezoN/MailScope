# PostgreSQL shared instance
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USER=mailscope
DATABASE_PASSWORD=mailscope

# App
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Gateway
API_PORT=3000
JWT_SECRET=change-me-in-production

# Auth service
AUTH_SERVICE_PORT=3002
AUTH_SERVICE_URL=http://auth-service-dev:3002
AUTH_DATABASE_NAME=mailscope_auth

# Investigations service
INVESTIGATIONS_SERVICE_PORT=3003
INVESTIGATIONS_SERVICE_URL=http://investigations-service-dev:3003
INVESTIGATIONS_DATABASE_NAME=mailscope_investigations

# OSINT service
OSINT_SERVICE_PORT=3001
OSINT_SERVICE_URL=http://osint-service-dev:3001
