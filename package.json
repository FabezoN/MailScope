{
  "name": "mailscope",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "lint": "pnpm -r --if-present lint",
    "lint:fix": "pnpm -r --if-present lint:fix",
    "format": "pnpm -r --if-present format",
    "format:check": "pnpm -r --if-present format:check",
    "test": "pnpm -r --if-present test",
    "ci": "pnpm -r --if-present lint && pnpm -r --if-present build"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@nestjs/core", "esbuild"]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.58.2"
  }
}
